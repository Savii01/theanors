# ==============================================================================
# TheAnors Content Operations Platform - Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary AI / LLM Configuration
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Alternative LLM Providers (for swappable LLM engine)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 2. Database & Auth (Supabase & Neon DB)
# ------------------------------------------------------------------------------
# Supabase (Real-time active workspace, prompts, and user sessions)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Authorized Admin Whitelist (comma-separated Google emails)
ALLOWED_ADMIN_EMAILS=user1@gmail.com,user2@gmail.com

# Legacy / Alternative keys format
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Neon PostgreSQL (Historical analytics & feedback loop storage)
DATABASE_URL=postgresql://user:password@ep-cool-host.region.aws.neon.tech/neondb?sslmode=require
NEON_CONNECTION_STRING=postgresql://user:password@ep-cool-host.region.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. Audio & Video Transcription APIs
# ------------------------------------------------------------------------------
# Used for video caption generation & script repurposing
GROQ_API_KEY=your_groq_api_key_here
# Note: Deepgram cap is 30 mins, AssemblyAI cap is 20 mins
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# ------------------------------------------------------------------------------
# 4. Optional Google Vision API (OCR for Engagement screenshots)
# ------------------------------------------------------------------------------
# (Note: Excel Theme History uses direct file upload — no Google Sheets API required)
GOOGLE_API_KEY=your_google_api_key_here

# ------------------------------------------------------------------------------
# 5. App Runtime Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
